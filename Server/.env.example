# PostgreSQL setting
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database

# Manager settings
MANAGER_HOST=manager
MANAGER_PORT=8000
MANAGER_PROCESSES=1

# Job settings
JOB_MINIMUM_SIZE=100000
JOB_MAXIMUM_SIZE=100000000
JOB_UPDATE_INTERVAL_SECONDS=300
JOB_EXPIRATION_TIME_SECONDS=600