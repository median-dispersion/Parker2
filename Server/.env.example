# PostgreSQL setting
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database

# Manager settings
MANAGER_HOST=manager
MANAGER_PORT=8000
MANAGER_PROCESSES=1
MANAGER_LOG_LEVEL=debug

# Job settings
JOB_MINIMUM_SIZE=200000000
JOB_MAXIMUM_SIZE=2000000000
JOB_TARGET_DURATION_SECONDS=1800
JOB_UPDATE_INTERVAL_SECONDS=60
JOB_UPDATE_TIMEOUT_SECONDS=120